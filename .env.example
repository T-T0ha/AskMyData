# Copy to .env and adjust. Every value has a working default.

# --- storage ---------------------------------------------------------------
# PostgreSQL is the deployment target (pgvector + LangGraph checkpoints).
DATABASE_URL=postgresql+psycopg://semantic:semantic@localhost:5433/semanticlayer
# For a quick local run without Docker, SQLite works for everything except
# pgvector similarity search (the app falls back to JSON embeddings):
# DATABASE_URL=sqlite:///./backend/var/semanticlayer.db

# --- Claude ----------------------------------------------------------------
# Without a key the platform still runs: taxonomy falls back to the rule engine,
# column descriptions fall back to a deterministic template, and the cleaning
# plan is produced by the built-in statistical planner.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5
# max_tokens covers the model's thinking as well as its reply — too small a
# budget truncates the JSON mid-object rather than returning a short answer.
CLAUDE_MAX_TOKENS=16000
# low | medium | high | xhigh | max — "low" suits the structured JSON asked for here.
CLAUDE_EFFORT=low

# --- database sources ------------------------------------------------------
# Reading from a SQLite file, a live PostgreSQL/MySQL connection or a SQL dump.
# A table larger than this is read up to the limit and flagged as truncated.
MAX_ROWS_PER_TABLE=200000
# Tables accepted from one connection in a single ingest.
MAX_TABLES_PER_SOURCE=50
SOURCE_CONNECT_TIMEOUT=10
SOURCE_STATEMENT_TIMEOUT=60

# --- authentication --------------------------------------------------------
# Passwords are hashed with stdlib scrypt; the work factors below are stored in
# every hash, so raising them is safe — existing hashes keep verifying and are
# upgraded on the owner's next successful login.
AUTH_SCRYPT_N=16384
AUTH_SCRYPT_R=8
AUTH_SCRYPT_P=1
AUTH_MIN_PASSWORD_LENGTH=10
# How long a login lasts (hours) before the user signs in again.
AUTH_TOKEN_TTL_HOURS=336
# Failed logins tolerated per email inside the window before it stops answering.
AUTH_MAX_FAILED_LOGINS=8
AUTH_FAILED_LOGIN_WINDOW_SECONDS=900
# Set false to close sign-ups once the intended users have accounts.
AUTH_REGISTRATION_OPEN=true

# --- detection thresholds --------------------------------------------------
EQUIVALENCE_THRESHOLD=0.75
NUMERIC_CONVERT_THRESHOLD=0.80
DATE_PARSE_THRESHOLD=0.80
DATE_TYPE_THRESHOLD=0.85
NOMINAL_UNIQUE_RATIO=0.20
